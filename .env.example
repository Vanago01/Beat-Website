# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VBEATS

# ─── Supabase (Project Settings → API Keys) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — or the legacy "service_role" key. SERVER ONLY. Never expose.
SUPABASE_SECRET_KEY=

# ─── Stripe (Developers → API keys / Webhooks) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: if Connect events (account.updated) use a separate endpoint/secret
STRIPE_CONNECT_WEBHOOK_SECRET=
# Country of your Stripe platform account (used for seller onboarding defaults)
STRIPE_CONNECT_DEFAULT_COUNTRY=PL

# ─── Transactional email via Resend (https://resend.com) ─────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "VBEATS <orders@yourdomain.com>"
EMAIL_FROM=

# ─── Optional: preview/tunnel mode (leave unset in production) ───────────────
# Use only when browsers cannot reach the Supabase URL directly (e.g. a remote
# preview of a local dev stack). The site then proxies /sb/* to Supabase.
# NEXT_PUBLIC_SUPABASE_BROWSER_PATH=/sb
# SUPABASE_PROXY_TARGET=http://127.0.0.1:54321
